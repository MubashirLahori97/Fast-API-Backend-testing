DATABASE_URL=postgresql+psycopg://genesis:genesis_local_only@127.0.0.1:5433/genesis_health

# Browser origins allowed to call the API, as a JSON list. 5173 is the Vite dev server.
CORS_ORIGINS=["http://localhost:5173"]

# Where new support requests are announced (story 10.1). The email names only the type and id.
SUPPORT_TEAM_EMAIL=support@genesishealth.local

# development | test | production. Production refuses the console email and push, the fake
# Oracle and the fake payment provider, so set real ones before changing it.
ENVIRONMENT=development
EMAIL_FROM="Your Oracle <no-reply@genesishealth.local>"
# Development emails go to the local test inbox (Mailpit, started by docker compose):
# open http://localhost:8025 to read them. Use EMAIL_BACKEND=console to print them in the
# server's log instead.
EMAIL_BACKEND=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Links in emails, with the token added. 5173 is the client web app, 5174 the admin panel.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
TEEN_INVITE_URL=http://localhost:5173/teen-invite
ADMIN_PANEL_URL=http://localhost:5174
ADMIN_INVITE_URL=http://localhost:5174/accept-invite
ADMIN_PASSWORD_RESET_URL=http://localhost:5174/reset-password

# Billing (Phase 8). The provider's hosted pages send the client back here. The webhook
# secret is a local-only value; the real provider needs its own.
BILLING_RETURN_URL=http://localhost:5173/billing
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret

# Stripe, test mode only here (docs/decisions/stripe-billing.md). Leave the key empty to use
# the fake provider. Put your own test key (sk_test_...) in .env, never in this file.
# The webhook secret comes from `stripe listen`; the price ids from
# scripts/create_stripe_prices.py.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INDIVIDUAL_PRICE_ID=
STRIPE_FAMILY_PRICE_ID=
STRIPE_FAMILY_ADD_ON_PRICE_ID=

# Which Oracle answers replies: fake (default) or senior, the senior team's dev chat API
# (docs/decisions/senior-chat-oracle.md). With senior, only the replies come from it: the
# safety check and everything else is still the fake, so it never runs in production. Send it
# test messages only, never real health data.
ORACLE_BACKEND=fake
SENIOR_CHAT_BASE_URL=https://oracle-clinician-dev-west-us.bravesea-f749ef56.westcentralus.azurecontainerapps.io
SENIOR_CHAT_TIMEOUT_SECONDS=30

# Wellness Plan links (story 7.1): placeholders until the store's and blog's links are known.
CALM_GUIDE_URL=https://blog.example.com/calm







